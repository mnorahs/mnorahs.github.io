<title>Work — Mirjam Sharon Schüßler</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --bg: #F5F2EE;
    --bg-card: #EFEBE5;
    --bg-dark: #2E2E2C;
    --text: #2E2E2C;
    --muted: #7A7870;
    --subtle: #B0ADA8;
    --border: rgba(46,46,44,0.1);
    --border-light: rgba(46,46,44,0.06);
    --sans: 'Syne', sans-serif;
  }
  html { scroll-behavior: smooth; }
  body { font-family: var(--sans); background: var(--bg); color: var(--text); font-size: 15px; line-height: 1.7; font-weight: 300; }

  /* NAV */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.2rem 3rem;
    background: rgba(245,242,238,0.93);
    backdrop-filter: blur(14px);
    border-bottom: 0.5px solid var(--border);
  }
  .nav-logo { font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text); text-decoration: none; font-weight: 500; }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); text-decoration: none; transition: color 0.2s; }
  .nav-links a:hover, .nav-links a.active { color: var(--text); }
  .rule { width: 100%; max-width: 1080px; margin: 0 auto; height: 0.5px; background: var(--border); }

  /* HERO */
  .page-hero {
    max-width: 1080px; margin: 0 auto;
    padding: 11rem 3rem 5rem;
  }
  .hero-eyebrow {
    font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--subtle); margin-bottom: 1.5rem;
    display: flex; align-items: center; gap: 1rem;
  }
  .hero-eyebrow::before { content: ''; width: 2.5rem; height: 0.5px; background: var(--subtle); }
  .page-hero h1 {
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 500; letter-spacing: -0.025em; line-height: 1.0;
    margin-bottom: 2rem; max-width: 16ch;
  }
  .page-hero p {
    font-size: 16px; color: var(--muted); max-width: 50ch;
    line-height: 1.75; font-weight: 300;
  }

  /* FILTER BAR */
  .filter-bar {
    max-width: 1080px; margin: 0 auto;
    padding: 0 3rem 4rem;
    display: flex; gap: 0.5rem; flex-wrap: wrap;
  }
  .filter-btn {
    font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 0.4rem 1.1rem; border: 0.5px solid var(--border);
    border-radius: 2rem; color: var(--muted); background: transparent;
    cursor: pointer; font-family: var(--sans); transition: all 0.2s;
  }
  .filter-btn:hover, .filter-btn.active {
    background: var(--text); color: var(--bg); border-color: var(--text);
  }

  /* PROJECT ENTRIES — alternating full-bleed layout */
  .projects-list { max-width: 1080px; margin: 0 auto; padding: 0 3rem; }

  .project-entry {
    padding: 6rem 0;
    border-top: 0.5px solid var(--border);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }
  .project-entry:last-child { border-bottom: 0.5px solid var(--border); }
  .project-entry.reverse { direction: rtl; }
  .project-entry.reverse > * { direction: ltr; }

  /* Project visual */
  .proj-visual {
    position: relative;
    aspect-ratio: 4/3;
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg-card);
    display: flex; align-items: center; justify-content: center;
  }
  .proj-visual-inner {
    width: 100%; height: 100%;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 1rem; padding: 2rem;
  }
  /* Unique colour per project */
  .c-sage    { background: #D6E0D6; }
  .c-slate   { background: #D4D8E2; }
  .c-sand    { background: #E2D8CC; }
  .c-rose    { background: #E2D0CC; }
  .c-teal    { background: #CCE0DC; }
  .c-mauve   { background: #DDD0E2; }
  .c-ochre   { background: #E2DCC8; }

  .proj-icon {
    width: 72px; height: 72px; border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,0.6);
    font-size: 2rem;
  }
  .proj-screen {
    width: 85%; background: #fff;
    border-radius: 8px; padding: 1.5rem;
    box-shadow: 0 8px 32px rgba(0,0,0,0.08);
    font-family: var(--sans);
  }
  .screen-bar {
    display: flex; gap: 5px; margin-bottom: 1rem;
  }
  .screen-bar span {
    width: 8px; height: 8px; border-radius: 50%;
    background: rgba(0,0,0,0.15);
  }
  .screen-line { height: 8px; border-radius: 4px; background: rgba(0,0,0,0.08); margin-bottom: 6px; }
  .screen-line.dark { background: rgba(0,0,0,0.18); width: 60%; }
  .screen-line.short { width: 40%; }
  .screen-row { display: flex; gap: 8px; margin-top: 10px; }
  .screen-block { flex: 1; height: 40px; border-radius: 4px; background: rgba(0,0,0,0.06); }
  .screen-badge { display: inline-block; height: 20px; width: 60px; border-radius: 10px; background: rgba(0,0,0,0.1); }

  /* Project copy */
  .proj-copy {}
  .proj-number {
    font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--subtle); margin-bottom: 1.5rem;
    display: flex; align-items: center; gap: 0.75rem;
  }
  .proj-number::after { content: ''; flex: 0 0 2rem; height: 0.5px; background: var(--subtle); }
  .proj-copy h2 {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 500; letter-spacing: -0.02em; line-height: 1.1;
    margin-bottom: 0.5rem;
  }
  .proj-copy .proj-subtitle {
    font-size: 14px; color: var(--subtle); margin-bottom: 2rem;
    font-weight: 400; letter-spacing: 0.02em;
  }
  .proj-block { margin-bottom: 1.75rem; }
  .proj-block-label {
    font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--subtle); margin-bottom: 0.4rem;
  }
  .proj-block p {
    font-size: 14px; color: var(--muted); line-height: 1.75;
  }
  .proj-meta {
    display: flex; gap: 2rem; margin-top: 2.5rem;
    padding-top: 1.5rem; border-top: 0.5px solid var(--border);
    flex-wrap: wrap;
  }
  .proj-meta-item {}
  .proj-meta-item .label {
    font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--subtle); display: block; margin-bottom: 0.2rem;
  }
  .proj-meta-item .value {
    font-size: 13px; color: var(--text); font-weight: 500;
  }
  .proj-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 2rem; }
  .proj-tag {
    font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--subtle); border: 0.5px solid var(--border);
    border-radius: 2rem; padding: 0.25rem 0.7rem;
  }

  /* NDA notice */
  .nda-notice {
    display: flex; align-items: flex-start; gap: 0.6rem;
    margin-top: 1.5rem; padding: 0.85rem 1.1rem;
    background: var(--bg-card); border-radius: 4px;
    font-size: 12px; color: var(--muted); line-height: 1.5;
  }
  .nda-notice svg { flex-shrink: 0; margin-top: 2px; opacity: 0.5; }

  /* VOLUNTARY SECTION */
  .vol-section {
    background: var(--bg-dark);
    margin-top: 6rem; padding: 6rem 0;
  }
  .vol-inner {
    max-width: 1080px; margin: 0 auto; padding: 0 3rem;
  }
  .vol-eyebrow {
    font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
    color: rgba(255,255,255,0.35); margin-bottom: 1rem;
    display: flex; align-items: center; gap: 1rem;
  }
  .vol-eyebrow::before { content: ''; width: 2rem; height: 0.5px; background: rgba(255,255,255,0.25); }
  .vol-section h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 500; letter-spacing: -0.02em;
    color: #F5F2EE; margin-bottom: 0.75rem;
  }
  .vol-section .vol-desc {
    font-size: 14px; color: rgba(255,255,255,0.45);
    max-width: 50ch; margin-bottom: 3.5rem; line-height: 1.75;
  }
  .vol-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
    background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px; overflow: hidden;
  }
  .vol-card {
    background: rgba(255,255,255,0.03);
    padding: 2rem; transition: background 0.2s;
  }
  .vol-card:hover { background: rgba(255,255,255,0.07); }
  .vol-year {
    font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase;
    color: rgba(255,255,255,0.3); margin-bottom: 1rem;
  }
  .vol-name {
    font-size: 15px; font-weight: 500; color: #F5F2EE;
    margin-bottom: 0.3rem; letter-spacing: -0.01em;
  }
  .vol-client {
    font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;
    color: rgba(255,255,255,0.3); margin-bottom: 1rem;
  }
  .vol-desc-text { font-size: 13px; color: rgba(255,255,255,0.5); line-height: 1.65; }
  .vol-tag {
    display: inline-block; font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase;
    color: rgba(255,255,255,0.3); border: 0.5px solid rgba(255,255,255,0.15);
    border-radius: 2rem; padding: 0.2rem 0.6rem; margin-top: 0.75rem; margin-right: 0.3rem;
  }

  /* FOOTER */
  footer {
    text-align: center; padding: 2.5rem;
    font-size: 11px; color: var(--subtle);
    letter-spacing: 0.08em; text-transform: uppercase;
    border-top: 0.5px solid var(--border);
  }
  footer a { color: var(--muted); text-decoration: none; }
  footer a:hover { color: var(--text); }
</style>
</head>
